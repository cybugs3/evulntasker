# =============================================================================
# EVulnTasker configuration
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# --- Runtime ---
# EVULNTASKER_* is current. VULNINTEL_* from older installs is still read.
EVULNTASKER_ENV=development
EVULNTASKER_SECRET_KEY=change-me-in-production
EVULNTASKER_HOST=0.0.0.0
EVULNTASKER_PORT=8080
EVULNTASKER_LOG_LEVEL=INFO
EVULNTASKER_LOG_DIR=./logs

# --- Database ---
# SQLite (default): sqlite:///./data/evulntasker.db
# Local PostgreSQL: postgresql+psycopg2://evulntasker:pass@127.0.0.1:5432/evulntasker?sslmode=disable
# Unix socket:      postgresql+psycopg2://evulntasker@/evulntasker?host=/var/run/postgresql
# External:         postgresql+psycopg2://user:pass@db.corp.local:5432/evulntasker?sslmode=prefer
# Can also be set from Settings → Database in the UI.
EVULNTASKER_DATABASE_URL=sqlite:///./data/evulntasker.db

# --- Scheduler ---
EVULNTASKER_FEED_POLL_SECONDS=300
EVULNTASKER_EMAIL_POLL_SECONDS=120
EVULNTASKER_WORKER_POLL_SECONDS=2
# How often to retry a CVE that is waiting for complete NVD/EPSS data (seconds, then backoff).
ENRICHMENT_RETRY_SECONDS=120

# --- Enrichment (NVD / EPSS / AI fill). Off = use ingested JSON and skip to matching. ---
ENRICHMENT_ENABLED=true

# --- NVD / EPSS (shown in Settings → Feeds → ATOM and Input Sources) ---
# First install seeds NVD + FIRST EPSS; lookup stays off until Enable lookup is on.
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_ENABLED=false
# Skip ingest for CVEs published before this date (YYYY-MM-DD). Set in Settings → Feeds.
# Applies to Local, SMB, Exchange, ATOM, inline ingest, webhooks, and Debugger.
INTEL_START_DATE=2024-01-01
INTEL_SOURCES_SEEDED=false
ATOM_FEEDS_SEEDED=false
ATOM_LOOKUPS_SEEDED=false

# --- EPSS (off until enabled in Settings, same as NVD) ---
EPSS_ENABLED=false
EPSS_API_BASE=https://api.first.org/data/v1/epss

# --- Jira ---
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=VULN
JIRA_HUNT_PROJECT_KEY=HUNT
JIRA_ISSUE_TYPE=Task

# --- Microsoft Exchange / Outlook ---
EXCHANGE_SERVER=
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=
EXCHANGE_EMAIL=
EXCHANGE_FOLDER=Inbox

# --- Asset inventory (teachers for Internal systems; not pipeline steps) ---
INVENTORY_SYNC_ENABLED=false
INVENTORY_SYNC_SECONDS=86400

# --- CMDB (local asset inventory API) ---
CMDB_ENABLED=false
CMDB_HOST=
CMDB_PORT=443
CMDB_USE_TLS=true
CMDB_IGNORE_CERT=false
CMDB_USERNAME=
CMDB_PASSWORD=
CMDB_API_PATH=/api
# Legacy full URL (optional if CMDB_HOST is set)
CMDB_API_URL=
CMDB_API_TOKEN=

# --- Sonatype / Nexus ---
SONATYPE_ENABLED=false
SONATYPE_HOST=
SONATYPE_PORT=8070
SONATYPE_USE_TLS=true
SONATYPE_IGNORE_CERT=false
SONATYPE_USERNAME=
SONATYPE_PASSWORD=
SONATYPE_API_PATH=
SONATYPE_API_URL=
SONATYPE_API_TOKEN=

# --- ITNM / network discovery (IBM Tivoli Network Manager or similar) ---
ITNM_ENABLED=false
ITNM_HOST=
ITNM_PORT=443
ITNM_USE_TLS=true
ITNM_IGNORE_CERT=false
ITNM_USERNAME=
ITNM_PASSWORD=
ITNM_API_PATH=/api
ITNM_API_URL=
ITNM_LIST_PATH=/devices

# --- Ticketing ---
# Each provider has its own Enable in Settings → Ticketing.
TICKETING_ENABLED=false
TICKETING_PROVIDER=jira
TICKETING_JIRA_ENABLED=false
TICKETING_MONDAY_ENABLED=false
TICKETING_EMAIL_ENABLED=false
TICKETING_CUSTOM_ENABLED=false
TICKETING_HOST=
TICKETING_PORT=443
TICKETING_USE_TLS=true
TICKETING_IGNORE_CERT=false
TICKETING_USERNAME=
TICKETING_PASSWORD=
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=
CUSTOM_TICKETING_API_PATH=/api/tickets
CUSTOM_OWNER_PROJECT=VULN
CUSTOM_HUNT_PROJECT=HUNT
# Permanent mailbox: always sent when this address is filled. Leave blank to skip.
TICKETING_HUNT_EMAIL=
# Used only when a matched Internal system has a blank owner_email. Leave blank to skip.
TICKETING_FALLBACK_OWNER_EMAIL=

# --- SMTP mail relay (Settings → Ticketing → Email). Lab / external recipients. ---
# TLS mode: plain | starttls | ssl
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=25
SMTP_RELAY_TLS_MODE=plain
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_RELAY_FROM=
SMTP_RELAY_IGNORE_CERT=false

# --- Gmail SMTP (Act step personal ticket). Uses smtp.gmail.com:587 STARTTLS.
# GMAIL_APP_PASSWORD is a Google App Password, not the account password.
# Leave blank to skip. A send failure never fails the pipeline. ---
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_RECEIVER_EMAIL=

# --- AI Co-pilot (OpenAI-compatible endpoint) ---
# Providers: gemini | chatgpt | azure_openai | github_copilot
# Off until an API key is saved. Enable in Settings → AI modules does nothing without a key.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_ENRICHMENT_MODE=direct
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --- Optional Celery ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
